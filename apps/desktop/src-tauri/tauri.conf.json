{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Devrem",
  "version": "0.1.0",
  "identifier": "com.devrem.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Devrem",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false,
        "backgroundColor": "#0B0E14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "HamzaShn",
    "copyright": "© 2026 HamzaShn. MIT Lisansı.",
    "category": "Education",
    "shortDescription": "Elektronik devre simülatörü",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Turkish", "English"],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQjJEQUU0ODc3OEY5NjMKUldSaitYaUg1TnF5Sy9FUDhIUVZMMmhiTm9jUVE0dlNHTHBFYU1wVkdBSnVKaDdqcmF4ZnhiYkMK",
      "endpoints": ["https://github.com/hamzashn/Devrem/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
